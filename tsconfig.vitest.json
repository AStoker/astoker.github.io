{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		// On for the site, off here: the generator's maths and the tests index into arrays
		// they've just built, where it would only add noise.
		"noUncheckedIndexedAccess": false,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "tools/**/*.ts"]
}
