{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		// On for the site, off here: the generator's maths and the tests index into arrays
		// they've just built, where it would only add noise.
		"noUncheckedIndexedAccess": false,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"lib": ["ES2023"],
		"types": ["node"],
		// The tools run straight through Node, which only strips types: no enums or namespaces.
		"erasableSyntaxOnly": true
	},
	"include": ["vite.config.ts", "tools/**/*.ts"],
	"exclude": ["tools/**/*.test.ts"]
}
